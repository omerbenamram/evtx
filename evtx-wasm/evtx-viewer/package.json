{
  "name": "evtx-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "test": "vitest",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings 0",
    "preview": "vite preview",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test --run"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@fluentui/react-icons": "^2.0.341",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "styled-components": "^6.5.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "bun@1.4.2"
}
